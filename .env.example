# Optional backend configuration; no paid service is required.
APP_NAME=Hackathon AI
# Optional SQLite path; defaults to data/cqa.sqlite3 under the repository root.
# Set process environment variables; .env is not loaded automatically.
# CQA_DB_PATH=C:/path/to/private/cqa.sqlite3
# Organizer GET URL for POST /api/groups/{group_id}/import (server-side only).
# CQA_SOURCE_URL=
# Alternative: private data/team-api/source_url.txt, excluded from Git.

# Participant 2: opt-in model adapter; see docs/PARTICIPANT_2_HANDOFF.md.
# Start backend.app.model_app:create_configured_app with uvicorn --factory.
# No request is sent until an evaluation job is submitted.
CQA_MODEL_ENABLED=0
# CQA_MODEL_PROVIDER=openai
# CQA_MODEL=<chosen model supporting Responses Structured Outputs>
# OPENAI_API_KEY=<server-side secret>
# CQA_CONTEXT_TOKENS=<confirmed context window of the chosen model>
# CQA_REQUEST_TIMEOUT=60
# CQA_TOTAL_TIMEOUT=150
# CQA_MAX_INPUT_CHARS=180000
# CQA_MAX_OUTPUT_TOKENS=12000
# CQA_KNOWLEDGE_PATH=C:/path/to/private/official-fragments.json
# Optional verified rates; leave unset when unknown (cost will be null).
# CQA_INPUT_USD_PER_MILLION=
# CQA_OUTPUT_USD_PER_MILLION=
