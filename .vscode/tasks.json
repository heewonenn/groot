{
  "version": "2.0.0",
  "tasks": [
    { "label": "Backend: dev", "type": "process", "command": "${workspaceFolder}/.venv/Scripts/python.exe", "args": ["-m", "uvicorn", "backend.app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8765"], "problemMatcher": [] },
    { "label": "Frontend: dev", "type": "shell", "command": "npm run dev", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Verify workspace", "type": "process", "command": "pwsh", "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/verify.ps1"], "group": "test", "problemMatcher": [] }
  ]
}
